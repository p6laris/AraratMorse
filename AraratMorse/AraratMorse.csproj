<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RunAOTCompilation>true</RunAOTCompilation>
        <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    </PropertyGroup>
    <ItemGroup>
        <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="ClipLazor" Version="4.0.0" />
        <PackageReference Include="MorseSharp" Version="6.1.0" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" />
    </ItemGroup>
    <ItemGroup>
        <TypeScriptCompile Include="wwwroot\js\Audio.ts" />
        <TypeScriptCompile Include="wwwroot\js\Sheets.ts" />
        <TypeScriptCompile Include="wwwroot\js\Tooltips.ts" />
    </ItemGroup>
    <ItemGroup>
        <None Include="wwwroot\css\app.css" />
        <None Include="wwwroot\css\app.css" />
    </ItemGroup>
</Project>
