@implements IDisposable

<div class="flex flex-col gap-5 items-center bg-white rounded-lg w-full lg:w-1/2 lg:mx-auto  text-black p-6">

    <div class="w-full flex items-center justify-between gap-4 -mb-2">
        <div class="flex items-center gap-4">
            <HistoryMenu/>
            <ShareButton/>
        </div>
        <ProsignHelp Language="State.Language"/>
    </div>

    @* Input *@
    <Textarea Placeholder="Type something..." Text="@State.Input" IsReadonly="false" TextChanged="Convert" Title="@fTitle()" />

    @* Output *@
    <Textarea Placeholder=" " Text="@State.Output" IsReadonly="true" Title="@sTitle()" />

    @* Error Section *@
    <TranslationError Error="State.ErrorInfo"/>
</div>

@code{

    #region States

    [Inject] private AppState State { get; set; } = default!;

    #endregion

    private string fTitle()
    {
        return State.IsEncoding ? "Text" : "Morse";
    }

    private string sTitle()
    {
        return State.IsEncoding ? "Morse" : "Text";
    }

    protected override void OnInitialized() => State.Changed += HandleStateChanged;

    void HandleStateChanged() => StateHasChanged();

    private void Convert(string input)
    {
        State.Translate(input);
    }

    public void Dispose() => State.Changed -= HandleStateChanged;

}
