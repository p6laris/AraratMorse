@using System.Globalization

@if (ReducedMotion)
{
    <div class="w-full h-full bg-black rounded-lg flex items-center justify-center">
        <span class="text-4xl font-mono tracking-widest @(IsOn ? "text-white" : "text-gray-600")">@(IsOn ? "ON" : "OFF")</span>
    </div>
}
else if (Mode == LampMode.SignalLamp)
{
    @* Sized against its box in both directions (container units), so it stays a circle on a wide,
       short screen as well as a tall one. *@
    <div class="w-full h-full bg-black rounded-lg flex items-center justify-center" style="container-type:size">
        <div class="rounded-full aspect-square" style="width:min(60cqh,45cqw);@LampFill(glow: true)"></div>
    </div>
}
else if (Mode == LampMode.TopBar)
{
    <div class="w-full h-full bg-black rounded-lg relative overflow-hidden">
        <div class="absolute top-0 left-0 right-0 h-4" style="@LampFill(glow: false)"></div>
    </div>
}
else
{
    <div class="w-full h-full rounded-lg relative z-0" style="@LampFill(glow: false, fullBleed: true)"></div>
}

@code {

    [Parameter] public bool IsOn { get; set; }

    [Parameter] public LampMode Mode { get; set; } = LampMode.FullScreen;

    [Parameter] public LampColor Color { get; set; } = LampColor.White;

    /// <summary>Opacity of the lit state, 0-1. Keeps a full-screen flash bearable at night.</summary>
    [Parameter] public double Brightness { get; set; } = 1.0;

    [Parameter] public bool ReducedMotion { get; set; }

    static string Hex(LampColor color) => color switch
    {
        LampColor.White => "#ffffff",
        LampColor.Amber => "#ffbf00",
        LampColor.Green => "#00e676",
        LampColor.Red => "#ff3b30",
        _ => "#ffffff"
    };

    // Colour only: each mode sizes its own element. (This used to set width/height to 100%, which
    // stretched the signal lamp into a pill and the top bar over the whole box.)
    string LampFill(bool glow, bool fullBleed = false)
    {
        var opacity = Math.Clamp(Brightness, 0, 1).ToString(CultureInfo.InvariantCulture);
        var color = Hex(Color);

        if (!IsOn)
            return $"background-color:{(fullBleed ? "#000" : "#222")}";

        var background = $"background-color:{color};opacity:{opacity}";
        return glow ? $"{background};box-shadow:0 0 40px {color}" : background;
    }

}
