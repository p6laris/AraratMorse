@using MorseSharp
@using MorseSharp.Audio
@implements IAsyncDisposable

<div class="flex flex-col gap-3 @(Size == PlayerSize.Full ? "w-full h-full" : "w-full")">

    @if (_errorOccurred)
    {
        <p class="@(OnDark ? "text-white" : "text-black") text-lg m-auto">Could not generate the @(Kind == PlayerKind.Light ? "light" : "audio").</p>
    }
    else
    {
        @* Visualization *@
        <div class="@(Size == PlayerSize.Full ? "flex-1 min-h-0" : "h-24") w-full relative rounded-xl overflow-hidden ring-1 @(OnDark ? "ring-white/10" : "ring-black/5")">
            @if (Kind is PlayerKind.Sound or PlayerKind.Both)
            {
                <WaveformView Id="@_soundId" WavBytes="_wavBytes"/>
            }
            @if (Kind is PlayerKind.Light or PlayerKind.Both)
            {
                <LampView IsOn="_isLightOn" Mode="LampMode" Color="LampColor" Brightness="LampBrightness"
                          ReducedMotion="@(ReducedMotion ?? _systemReducedMotion)"/>
            }
        </div>

        @if (ShowTimeline && _sequence is not null)
        {
            <ElementTimeline Id="@_timelineId" Sequence="_sequence"
                             PlayheadRatio="@(Kind == PlayerKind.Light ? _lightPlayheadRatio : null)"/>
        }

        @* Controls *@
        <div class="flex items-center justify-between gap-3">
            <p class="min-w-0 truncate text-xs tabular-nums @(OnDark ? "text-white/70" : "text-gray-500")">
                @if (Kind is PlayerKind.Light or PlayerKind.Both && LightProgressText is { } progress)
                {
                    @progress
                }
                else if (_sequence is not null)
                {
                    @* The elapsed span is filled in by JS as the audio plays; Blazor never renders into it. *@
                    <span id="@_elapsedId"></span><span> / @FormatDuration(TotalDuration)</span>
                }
            </p>

            <div class="flex items-center gap-1.5 shrink-0">
                <button type="button" @onclick="StopAsync" disabled="@(!CanStop)" aria-label="Stop" title="Stop"
                        class="@GhostButton">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16">
                        <path fill="currentColor" d="M4.5 3A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13h7a1.5 1.5 0 0 0 1.5-1.5v-7A1.5 1.5 0 0 0 11.5 3h-7Z"/>
                    </svg>
                </button>

                <button type="button" @onclick="TogglePlayAsync" aria-label="@(_isPlaying ? "Pause" : "Play")" title="@(_isPlaying ? "Pause (Space)" : "Play (Space)")"
                        class="w-11 h-11 rounded-full flex items-center justify-center transition-transform active:scale-95 shadow-sm
                               @(OnDark ? "bg-white text-black hover:bg-gray-200" : "bg-black text-white hover:bg-gray-800")">
                    @if (_isPlaying)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16">
                            <path fill="currentColor" d="M3.75 2A1.75 1.75 0 0 0 2 3.75v8.5c0 .966.784 1.75 1.75 1.75h1.5A1.75 1.75 0 0 0 7 12.25v-8.5A1.75 1.75 0 0 0 5.25 2h-1.5Zm7 0A1.75 1.75 0 0 0 9 3.75v8.5c0 .966.784 1.75 1.75 1.75h1.5A1.75 1.75 0 0 0 14 12.25v-8.5A1.75 1.75 0 0 0 12.25 2h-1.5Z"/>
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" class="translate-x-px">
                            <path fill="currentColor" d="M6.235 2.192A1.5 1.5 0 0 0 4 3.499v9a1.5 1.5 0 0 0 2.235 1.308l8-4.5a1.5 1.5 0 0 0 0-2.615l-8-4.5Z"/>
                        </svg>
                    }
                </button>

                @if (Kind is PlayerKind.Sound or PlayerKind.Both)
                {
                    <button type="button" @onclick="Download" aria-label="Download WAV" title="Download WAV" class="@GhostButton">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24">
                            <path fill="currentColor" d="M12 3a1 1 0 0 1 1 1v9.586l2.293-2.293a1 1 0 1 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L11 13.586V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1Z"/>
                        </svg>
                    </button>
                }
            </div>
        </div>
    }

    @if (Kind is PlayerKind.Sound or PlayerKind.Both)
    {
        <audio id="@_soundId" class="hidden"></audio>
    }

</div>

@code {

    [Parameter, EditorRequired] public string MorseText { get; set; } = default!;

    [Parameter, EditorRequired] public Language Language { get; set; }

    [Parameter] public PlayerKind Kind { get; set; } = PlayerKind.Sound;

    [Parameter] public PlayerSize Size { get; set; } = PlayerSize.Full;

    [Parameter] public bool ShowTimeline { get; set; } = true;

    /// <summary>Whether this player is currently visible/open — gates (re)generation so it only
    /// happens on the closed-to-open transition or when the source text/language actually change
    /// while open, not on every unrelated re-render.</summary>
    [Parameter] public bool Active { get; set; } = true;

    [Parameter] public string DownloadName { get; set; } = "morse";

    [Parameter] public LampMode LampMode { get; set; } = LampMode.FullScreen;

    [Parameter] public LampColor LampColor { get; set; } = LampColor.White;

    [Parameter] public double LampBrightness { get; set; } = 1.0;

    /// <summary>Shows the light as an ON/OFF readout instead of flashing. Null follows the
    /// device's reduce-motion setting.</summary>
    [Parameter] public bool? ReducedMotion { get; set; }

    /// <summary>Drives the camera-flash torch (best effort) alongside the light loop. The host is
    /// responsible for feature-detecting support and only offering this when available.</summary>
    [Parameter] public bool TorchEnabled { get; set; }

    /// <summary>Overrides the injected <see cref="MorseSettings"/> speeds/tone/format — for
    /// callers (like the Koch trainer) that need their own Farnsworth pacing independent of the
    /// shared converter settings. Any left null fall back to the injected settings.</summary>
    [Parameter] public int? CharSpeedOverride { get; set; }

    [Parameter] public int? WordSpeedOverride { get; set; }

    [Parameter] public double? FrequencyOverride { get; set; }

    [Parameter] public AudioFormat? FormatOverride { get; set; }

    [Inject] private State.MorseService MorseService { get; set; } = default!;

    [Inject] private State.MorseSettings Settings { get; set; } = default!;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    int EffectiveCharSpeed => CharSpeedOverride ?? Settings.CharSpeed;
    int EffectiveWordSpeed => WordSpeedOverride ?? Settings.WordSpeed;
    double EffectiveFrequency => FrequencyOverride ?? Settings.Frequency;
    AudioFormat EffectiveFormat => FormatOverride ?? Settings.Format;

    // Full-size players live on the black bottom sheets; inline ones sit on white cards.
    bool OnDark => Size == PlayerSize.Full;

    string GhostButton => "w-9 h-9 rounded-full flex items-center justify-center transition-colors disabled:opacity-30 disabled:cursor-not-allowed "
                          + (OnDark ? "text-white/80 hover:bg-white/10" : "text-gray-600 hover:bg-gray-100");

    readonly string _instanceId = $"player-{Guid.NewGuid():N}";
    string _soundId => $"{_instanceId}-audio";
    string _elapsedId => $"{_instanceId}-elapsed";
    string _waveformPlayheadId => $"{_soundId}-playhead";
    string _timelineId => $"{_instanceId}-timeline";
    string _timelinePlayheadId => $"{_timelineId}-playhead";
    string _timelineTrackId => $"{_timelineId}-track";

    DotNetObjectReference<MorsePlayer>? _selfRef;

    byte[]? _wavBytes;
    MorseElementSequence? _sequence;
    bool _errorOccurred;
    bool _isPlaying;
    bool _isPaused;
    bool _isLightOn;
    bool _systemReducedMotion;
    bool _lightRunning;
    bool _needsAudioPush;

    bool CanStop => _isPlaying || _isPaused;

    TimeSpan TotalDuration => _sequence?.Duration ?? TimeSpan.Zero;

    List<MorseElement>? _lightElements;
    int _lightElementsPlayed;
    double _lightElapsedMs;
    double? _lightPlayheadRatio;
    CancellationTokenSource? _lightCts;

    string? LightProgressText
    {
        get
        {
            if (_lightElements is not { Count: > 0 } elements || _sequence is not { } sequence)
                return null;

            var remainingMs = Math.Max(0, sequence.Duration.TotalMilliseconds - _lightElapsedMs);
            return $"{_lightElementsPlayed}/{elements.Count} · {FormatDuration(TimeSpan.FromMilliseconds(remainingMs))} left";
        }
    }

    bool _wasActive;
    string? _lastMorseText;
    Language? _lastLanguage;
    PlayerKind? _lastKind;

    protected override void OnParametersSet()
    {
        var justOpened = Active && !_wasActive;
        var inputChanged = Active && (MorseText != _lastMorseText || Language != _lastLanguage || Kind != _lastKind);

        if (justOpened || inputChanged)
        {
            Regenerate();
            _lastMorseText = MorseText;
            _lastLanguage = Language;
            _lastKind = Kind;
        }

        _wasActive = Active;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ReducedMotion is null)
        {
            _systemReducedMotion = await JS.InvokeAsync<bool>("araratMorseMotion.prefersReduced");
            if (_systemReducedMotion)
                StateHasChanged();
        }

        if (_needsAudioPush && _wavBytes is not null)
        {
            _needsAudioPush = false;
            _selfRef ??= DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync("araratMorse.setSource", _soundId, _wavBytes);
            await JS.InvokeVoidAsync("araratMorse.watch", _soundId, _selfRef, _elapsedId);
            await JS.InvokeVoidAsync("araratMorse.attachPlayhead", _soundId, _waveformPlayheadId, (string?)null);

            if (ShowTimeline)
                await JS.InvokeVoidAsync("araratMorse.attachPlayhead", _soundId, _timelinePlayheadId, _timelineTrackId);
        }
    }

    void Regenerate()
    {
        // New source: whatever was playing is gone, so the controls must not claim otherwise.
        _lightCts?.Cancel();
        _isPlaying = false;
        _isPaused = false;
        _isLightOn = false;

        try
        {
            if (Kind is PlayerKind.Sound or PlayerKind.Both)
            {
                _wavBytes = MorseService.GetWav(MorseText, Language, EffectiveCharSpeed, EffectiveWordSpeed,
                    EffectiveFrequency, EffectiveFormat);
                _needsAudioPush = true;
            }

            _lightElements = null;

            // Always built: it's cheap, and it's where the total duration shown in the controls comes from.
            _sequence = MorseService.GetElements(MorseText, Language, EffectiveCharSpeed, EffectiveWordSpeed);

            if (Kind is PlayerKind.Light or PlayerKind.Both)
            {
                var elements = new List<MorseElement>();
                foreach (var element in _sequence.Value)
                    elements.Add(element);
                _lightElements = elements;
            }

            _lightElementsPlayed = 0;
            _lightElapsedMs = 0;
            _lightPlayheadRatio = 0;
            _errorOccurred = false;
        }
        catch (Exception ex)
        {
            Console.Write(ex.Message);
            _errorOccurred = true;
            _wavBytes = null;
            _sequence = null;
        }
    }

    Task TogglePlayAsync() => _isPlaying ? PauseAsync() : PlayAsync();

    async Task PlayAsync()
    {
        if (_errorOccurred || _isPlaying)
            return;

        _isPlaying = true;
        _isPaused = false;

        if (Kind is PlayerKind.Sound or PlayerKind.Both)
        {
            var started = await JS.InvokeAsync<bool>("araratMorse.play", _soundId);
            if (!started)
            {
                _isPlaying = false;
                return;
            }
        }

        if (Kind is PlayerKind.Light or PlayerKind.Both)
            _ = PlayLightAsync();
    }

    [JSInvokable]
    public void OnPlaybackEnded()
    {
        if (_lightRunning)
            return;

        _isPlaying = false;
        _isPaused = false;
        StateHasChanged();
    }

    async Task PlayLightAsync()
    {
        _lightCts = new CancellationTokenSource();
        var token = _lightCts.Token;
        var finished = false;
        _lightRunning = true;

        try
        {
            if (_lightElementsPlayed == 0)
            {
                // Fresh start: MorseSharp's own PlayAsync paces this in real time with drift
                // compensation, and switches the light off before the task observes cancellation.
                await foreach (var element in MorseService.PlayLightElements(MorseText, Language,
                                   EffectiveCharSpeed, EffectiveWordSpeed, token))
                {
                    ApplyLightElement(element);
                }
            }
            else if (_lightElements is not null)
            {
                // Resume: walk the remaining elements from the sequence already computed for the
                // full text, rather than re-deriving a "remaining morse" substring by character
                // count (which is what produced garbage after a pause previously).
                foreach (var element in _lightElements.Skip(_lightElementsPlayed))
                {
                    token.ThrowIfCancellationRequested();
                    await Task.Delay(element.Duration, token);
                    ApplyLightElement(element);
                }
            }

            finished = true;
            _errorOccurred = false;
        }
        catch (OperationCanceledException)
        {
            // Manual resume loop doesn't get PlayAsync's own light-off-before-cancel guarantee.
            _isLightOn = false;
        }
        catch
        {
            _errorOccurred = true;
        }
        finally
        {
            _lightRunning = false;
            _isLightOn = false;

            // Paused/stopped callers already set their own state; only a natural end resets here.
            if (finished || _errorOccurred)
            {
                _isPlaying = false;
                _isPaused = false;
                _lightElementsPlayed = 0;
                _lightElapsedMs = 0;
                _lightPlayheadRatio = 0;
            }

            if (TorchEnabled)
                _ = SetTorchAsync(false);

            StateHasChanged();
        }
    }

    void ApplyLightElement(MorseElement element)
    {
        _isLightOn = element.KeyDown;
        _lightElapsedMs += element.Duration.TotalMilliseconds;
        ++_lightElementsPlayed;

        var totalMs = _sequence?.Duration.TotalMilliseconds ?? 0;
        _lightPlayheadRatio = totalMs > 0 ? _lightElapsedMs / totalMs * 100 : 0;

        if (TorchEnabled)
            _ = SetTorchAsync(element.KeyDown);

        StateHasChanged();
    }

    async Task SetTorchAsync(bool on)
    {
        try
        {
            await JS.InvokeVoidAsync("araratMorseTorch.setTorch", on);
        }
        catch
        {
            // best effort — a lost/racing JS call here shouldn't break playback
        }
    }

    async Task PauseAsync()
    {
        if (!_isPlaying)
            return;

        _isPlaying = false;
        _isPaused = true;

        if (Kind is PlayerKind.Sound or PlayerKind.Both)
            await JS.InvokeVoidAsync("araratMorse.pause", _soundId);

        if (Kind is PlayerKind.Light or PlayerKind.Both)
            _lightCts?.Cancel();
    }

    public async Task StopAsync()
    {
        _isPlaying = false;
        _isPaused = false;

        if (Kind is PlayerKind.Sound or PlayerKind.Both)
            await JS.InvokeVoidAsync("araratMorse.stop", _soundId);

        if (Kind is PlayerKind.Light or PlayerKind.Both)
        {
            _lightCts?.Cancel();
            _lightElementsPlayed = 0;
            _lightElapsedMs = 0;
            _lightPlayheadRatio = 0;
            _isLightOn = false;

            if (TorchEnabled)
                await SetTorchAsync(false);
        }
    }

    async Task Download()
    {
        await JS.InvokeVoidAsync("araratMorse.download", _soundId, $"{DownloadName}.wav");
    }

    static string FormatDuration(TimeSpan duration) =>
        duration.TotalMinutes >= 1 ? duration.ToString(@"m\:ss\.f") : duration.ToString(@"s\.f") + "s";

    public async ValueTask DisposeAsync()
    {
        _lightCts?.Cancel();

        if (TorchEnabled)
            await SetTorchAsync(false);

        if (Kind is PlayerKind.Sound or PlayerKind.Both)
        {
            try
            {
                await JS.InvokeVoidAsync("araratMorse.disposePlayer", _soundId,
                    new[] { _waveformPlayheadId, _timelinePlayheadId });
            }
            catch (JSDisconnectedException)
            {
                // page is going away
            }
        }

        _selfRef?.Dispose();
    }

}
