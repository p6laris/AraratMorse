@using System.Globalization
@using MorseSharp

<div class="w-full h-9 bg-neutral-900 rounded-xl overflow-hidden px-3">
<div id="@TrackId" class="relative w-full h-full flex items-stretch">
    @foreach (var item in _items)
    {
        @if (item.IsGap)
        {
            <div class="h-full" style="width:@Pct(item.WidthPercent)"></div>
        }
        else
        {
            @* One group per character, so the playing character can light up as a whole. *@
            <div class="timeline-char h-full flex items-center rounded-md transition-colors duration-100 @(IsActive(item) ? ActiveClass : "")"
                 data-start="@Num(item.Start)" data-end="@Num(item.End)" style="width:@Pct(item.WidthPercent)">
                @foreach (var mark in item.Marks)
                {
                    <div class="h-2.5 rounded-full @(mark.KeyDown ? "bg-white" : "")" style="width:@Pct(mark.WidthPercent)"></div>
                }
            </div>
        }
    }

    @* Progress overlay; driven by JS for audio, or by PlayheadRatio for the light player. *@
    <div id="@PlayheadId" class="absolute inset-y-0 left-0 bg-white/10 border-r-2 border-rose-500 pointer-events-none"
         style="width:@Pct(PlayheadRatio ?? 0);opacity:@((PlayheadRatio ?? 0) > 0 ? "1" : "0")"></div>
</div>
</div>

@code {

    /// <summary>The highlight on the character under the playhead. JS toggles the same class.</summary>
    public const string ActiveClass = "bg-white/15";

    [Parameter, EditorRequired] public string Id { get; set; } = default!;

    [Parameter] public MorseElementSequence? Sequence { get; set; }

    /// <summary>
    /// Playhead position as a 0-100 percentage of the sounding part (see <see cref="SoundingDuration"/>).
    /// When set (the light player), the playhead and highlight render from it; when null, the
    /// audio player's JS sync moves them instead.
    /// </summary>
    [Parameter] public double? PlayheadRatio { get; set; }

    public string TrackId => $"{Id}-track";
    public string PlayheadId => $"{Id}-playhead";

    /// <summary>The sequence up to the end of its last tone — every sequence ends in a gap that
    /// would otherwise take up the right side of the strip for nothing.</summary>
    public static TimeSpan SoundingDuration(MorseElementSequence sequence)
    {
        var total = TimeSpan.Zero;
        var soundingEnd = TimeSpan.Zero;
        foreach (var element in sequence)
        {
            total += element.Duration;
            if (element.KeyDown)
                soundingEnd = total;
        }
        return soundingEnd;
    }

    record Mark(double WidthPercent, bool KeyDown);

    record Item(bool IsGap, double WidthPercent, double Start, double End, List<Mark> Marks);

    List<Item> _items = [];
    MorseElementSequence? _built;

    protected override void OnParametersSet()
    {
        // Only rebuild for a new sequence; the light player re-renders this on every element.
        if (_built is { } built && Sequence is { } current && built.Equals(current))
            return;

        _built = Sequence;
        BuildItems();
    }

    bool IsActive(Item item) =>
        PlayheadRatio is double ratio && ratio > 0 && ratio / 100 >= item.Start && ratio / 100 < item.End;

    void BuildItems()
    {
        _items = [];

        if (Sequence is not { } sequence)
            return;

        var totalMs = SoundingDuration(sequence).TotalMilliseconds;
        if (totalMs <= 0)
            return;

        List<(double DurationMs, bool KeyDown)>? currentChar = null;
        var charStartMs = 0d;
        var elapsedMs = 0d;

        void FlushChar(double endMs)
        {
            if (currentChar is null)
                return;

            // Mark widths are percentages of the character group's own box (CSS % is relative
            // to the parent), so they're only knowable once the character's total duration is.
            var charDurationMs = endMs - charStartMs;
            var marks = currentChar
                .Select(m => new Mark(m.DurationMs / charDurationMs * 100, m.KeyDown))
                .ToList();

            _items.Add(new Item(false, charDurationMs / totalMs * 100, charStartMs / totalMs,
                endMs / totalMs, marks));
            currentChar = null;
        }

        foreach (var element in sequence)
        {
            if (elapsedMs >= totalMs)
                break; // the trailing gap

            var durationMs = element.Duration.TotalMilliseconds;

            switch (element.Kind)
            {
                case MorseElementKind.Dot:
                case MorseElementKind.Dash:
                case MorseElementKind.ElementGap:
                    if (currentChar is null)
                    {
                        currentChar = [];
                        charStartMs = elapsedMs;
                    }
                    currentChar.Add((durationMs, element.KeyDown));
                    break;
                case MorseElementKind.CharGap:
                case MorseElementKind.WordGap:
                    FlushChar(elapsedMs);
                    _items.Add(new Item(true, durationMs / totalMs * 100, elapsedMs / totalMs,
                        (elapsedMs + durationMs) / totalMs, []));
                    break;
            }

            elapsedMs += durationMs;
        }

        FlushChar(Math.Min(elapsedMs, totalMs));
    }

    static string Num(double value) => value.ToString(CultureInfo.InvariantCulture);

    static string Pct(double value) => value.ToString(CultureInfo.InvariantCulture) + "%";

}
