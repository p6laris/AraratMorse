@using System.Runtime.InteropServices
@using AraratMorse.State
@using MorseSharp
@implements IAsyncDisposable

@* Overlay *@
<div @onclick="Close" data-sheet-overlay="decode-mic" class="@(IsOpened ? "fixed" : "hidden") inset-0 bg-black z-20 opacity-10"></div>

<div data-sheet="decode-mic" inert="@(!IsOpened)" tabindex="-1" role="dialog" aria-modal="true" aria-label="Decode from microphone"
     class="fixed bottom-0 left-0 flex flex-col bg-black text-white items-center w-full h-full rounded-t-lg p-5 mt-10 z-50 transition-transform shadow-top @(!IsOpened ? "translate-y-full" : "translate-y-0")">

    <div class="flex items-center justify-between w-full mb-6">
        <button @onclick="Close" class="text-white rounded-full p-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24">
                <path fill="currentColor" d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10s10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17L12 13.41L8.41 17L7 15.59L10.59 12L7 8.41L8.41 7L12 10.59L15.59 7L17 8.41L13.41 12L17 15.59z"/>
            </svg>
        </button>
        <h3 class="text-lg font-medium">Decode from microphone</h3>
        <span class="w-[14px]"></span>
    </div>

    <div class="flex flex-col gap-4 w-full max-w-sm mx-auto">

        <div class="grid grid-cols-2 gap-4">
            <label class="flex flex-col gap-1.5 text-sm">
                <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">Tone (Hz)</span>
                <input type="number" @bind=_frequency disabled="@_isListening"
                       class="border border-gray-600 bg-transparent rounded-lg px-3 py-2 disabled:opacity-50
                              focus:outline-none focus:ring-2 focus:ring-white/20"/>
            </label>
            <label class="flex flex-col gap-1.5 text-sm">
                <span class="text-xs font-medium text-gray-400 uppercase tracking-wide">Approx. WPM</span>
                <input type="number" @bind=_wordsPerMinute disabled="@_isListening"
                       class="border border-gray-600 bg-transparent rounded-lg px-3 py-2 disabled:opacity-50
                              focus:outline-none focus:ring-2 focus:ring-white/20"/>
            </label>
        </div>

        @if (_errorMessage is not null)
        {
            <p class="text-rose-400 text-sm">@_errorMessage</p>
        }

        <div dir="auto" class="bg-white text-black rounded-xl p-4 text-sm min-h-24 break-words">
            @if (string.IsNullOrEmpty(_liveText))
            {
                <span class="text-gray-400">@(_isListening ? "Listening..." : "Nothing decoded yet.")</span>
            }
            else
            {
                @_liveText
            }
        </div>

        @if (!_isListening)
        {
            <button @onclick="StartAsync" class="bg-white text-black font-medium rounded-xl py-3">
                Start listening
            </button>
        }
        else
        {
            <button @onclick="StopAsync" class="bg-rose-500 hover:bg-rose-600 transition-colors text-white font-medium rounded-xl py-3">
                Stop
            </button>
        }

        @if (!string.IsNullOrEmpty(_liveText))
        {
            <button @onclick="UseResult" class="bg-white/10 hover:bg-white/20 transition-colors text-white font-medium rounded-xl py-3">
                Use in converter
            </button>
        }

        <p class="text-xs text-gray-500">
            Characters appear as they're recognized. The decoder measures the real speed and tone
            as it listens, so the values above only need to be roughly right.
        </p>
    </div>

</div>

@code {

    [Parameter] public bool IsOpened { get; set; }

    [Inject] private AppState State { get; set; } = default!;

    [Inject] private MorseService MorseService { get; set; } = default!;

    [Inject] private IJSRuntime JS { get; set; } = default!;

    int _frequency = 700;
    int _wordsPerMinute = 20;
    bool _isListening;
    string? _errorMessage;
    string _liveText = "";

    StreamingMorseDecoder? _decoder;
    DotNetObjectReference<DecodeFromMicSection>? _selfRef;

    async Task StartAsync()
    {
        _errorMessage = null;
        _liveText = "";
        _selfRef ??= DotNetObjectReference.Create(this);

        int sampleRate;
        try
        {
            sampleRate = await JS.InvokeAsync<int>("araratMorseMic.start", _selfRef);
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            return;
        }

        if (sampleRate <= 0)
        {
            _errorMessage = "Microphone access was denied or isn't available.";
            return;
        }

        _decoder = MorseService.CreateAudioDecoder(State.Language, sampleRate, _frequency, _wordsPerMinute);
        _isListening = true;
    }

    [JSInvokable]
    public void OnAudioChunk(byte[] bytes)
    {
        if (_decoder is null)
            return;

        var samples = MemoryMarshal.Cast<byte, short>(bytes);
        _decoder.Write(samples);

        while (_decoder.TryRead(out var ch))
            _liveText += ch;

        InvokeAsync(StateHasChanged);
    }

    async Task StopAsync()
    {
        await JS.InvokeVoidAsync("araratMorseMic.stop");
        _isListening = false;

        if (_decoder is not null)
        {
            _decoder.Flush();
            while (_decoder.TryRead(out var ch))
                _liveText += ch;
            _decoder = null;
        }
    }

    void UseResult()
    {
        if (string.IsNullOrEmpty(_liveText))
            return;

        State.SetDecodedText(_liveText);
    }

    void Close()
    {
        if (_isListening)
            _ = StopAsync();

        State.ClosePanel();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isListening)
        {
            try
            {
                await JS.InvokeVoidAsync("araratMorseMic.stop");
            }
            catch
            {
                // best effort — page may already be tearing down
            }
        }

        _selfRef?.Dispose();
    }

}
