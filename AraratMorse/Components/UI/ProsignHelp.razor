@using MorseSharp

<div class="relative w-full flex justify-end -mb-2">
    <button @onclick="Toggle" type="button" title="Prosigns"
            class="text-xs text-gray-500 hover:text-black flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0-20Zm.75 15h-1.5v-1.5h1.5V17Zm1.29-6.24l-.68.7c-.54.55-.86.95-.86 1.79h-1.5v-.36c0-.66.24-1.24.68-1.7l.94-.96c.3-.3.45-.7.45-1.13a1.92 1.92 0 1 0-3.84 0h-1.5a3.42 3.42 0 1 1 6.84 0c0 .74-.28 1.4-.77 1.9Z"/>
        </svg>
        Prosigns
    </button>

    @if (_open)
    {
        <div class="absolute top-6 right-0 z-30 bg-white text-black border border-gray-200 rounded-xl shadow-lg p-4 w-72 text-sm">
            <p class="text-xs text-gray-500 mb-3">
                Write a prosign in brackets, like <span class="font-mono">&lt;AR&gt;</span> — it keys as one
                unbroken signal, not separate letters.
            </p>
            <ul class="flex flex-col gap-1 max-h-56 overflow-y-auto">
                @foreach (var prosign in Prosigns)
                {
                    <li class="flex justify-between gap-3 font-mono">
                        <span>&lt;@prosign.Name&gt;</span>
                        <span class="text-gray-500 tracking-widest">@prosign.Pattern</span>
                    </li>
                }
            </ul>
            @if (Prosigns.Count == 0)
            {
                <p class="text-gray-400 text-xs">This language doesn't define any prosigns.</p>
            }
        </div>
    }
</div>

@code {

    [Parameter, EditorRequired] public Language Language { get; set; }

    bool _open;

    IReadOnlyList<MorseProsignEntry> Prosigns => MorseAlphabet.ForLanguage(Language).Prosigns;

    void Toggle() => _open = !_open;

}
