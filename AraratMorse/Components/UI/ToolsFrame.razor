@implements IDisposable

@* Light and Sound Button *@
<div class="flex justify-between text-white items-center w-full lg:w-1/2 lg:mx-auto rounded-lg p-2 mt-10">
    <button @onclick="ToggleSoundBar" disabled="@(!ShouldSectionOpen())"
            aria-label="Play as sound" title="@(ShouldSectionOpen() ? "Play as sound" : NothingToPlay)"
            class="@ToolButton">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 16 16">
            <path d="M8.694 2.04a.5.5 0 0 1 .298.375L9 2.5v11a.5.5 0 0 1-.785.411l-.066-.054l-2.926-2.875H3.5a1.5 1.5 0 0 1-1.494-1.356L2 9.482v-2.99A1.5 1.5 0 0 1 3.355 5l.145-.007h1.724l2.927-2.851a.5.5 0 0 1 .543-.103zm3.043 1.02l.087.058l.098.085c.063.056.15.138.252.245c.206.213.476.527.746.938a6.542 6.542 0 0 1 1.083 3.618a6.522 6.522 0 0 1-1.083 3.614c-.27.41-.541.724-.746.936l-.142.141l-.187.17l-.033.026a.5.5 0 0 1-.688-.72l.13-.117a5.49 5.49 0 0 0 .83-.985c.46-.7.919-1.73.919-3.065a5.542 5.542 0 0 0-.919-3.069a5.588 5.588 0 0 0-.54-.698l-.17-.176l-.184-.17a.5.5 0 0 1 .547-.832zm-.999 2l.1.069l.133.126l.054.056c.114.123.26.302.405.54c.292.48.574 1.193.574 2.148c0 .954-.282 1.668-.573 2.148a3.388 3.388 0 0 1-.405.541l-.102.105l-.07.065l-.04.033l-.063.03c-.133.052-.442.139-.64-.108a.5.5 0 0 1 .012-.638l.134-.129l.034-.036c.075-.08.179-.208.284-.382c.21-.345.429-.882.429-1.63c0-.747-.219-1.283-.428-1.627a2.467 2.467 0 0 0-.223-.311l-.095-.105l-.069-.065a.5.5 0 0 1 .55-.83z" fill="currentColor" fill-rule="nonzero"/>
        </svg>
    </button>
    <button @onclick="ToggleLightBar" disabled="@(!ShouldSectionOpen())"
            aria-label="Play as light" title="@(ShouldSectionOpen() ? "Play as light" : NothingToPlay)"
            class="@ToolButton">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 20 20">
            <path fill="currentColor" d="M9.248 2.066a.5.5 0 0 0-.496 0L5.571 3.884A1.133 1.133 0 0 0 6 5.992v2.194a2 2 0 0 0-1.145 1.593l-.79 7.11A1 1 0 0 0 5.059 18h7.882a1 1 0 0 0 .994-1.11l-.79-7.11A2 2 0 0 0 12 8.185V5.992a1.133 1.133 0 0 0 .43-2.108L9.247 2.066ZM11 8H7V6h4v2Zm-5.483 4.88l6.766-1.805l.212 1.909l-7.203 1.92l.225-2.024ZM16.5 7h-2a.5.5 0 1 1 0-1h2a.5.5 0 0 1 0 1Zm-.646-3.146a.5.5 0 1 0-.707-.708l-1 1a.5.5 0 0 0 .707.708l1-1Zm0 6a.5.5 0 0 0 0-.708l-1-1a.5.5 0 1 0-.707.708l1 1a.5.5 0 0 0 .707 0Z"/>
        </svg>
    </button>
    <button @onclick="ToggleDecodeFileBar" title="Decode audio from a WAV file" aria-label="Decode audio from a WAV file" class="@ToolButton">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 3a1 1 0 0 1 1 1v9.586l2.293-2.293a1 1 0 1 1 1.414 1.414l-4 4a1 1 0 0 1-1.414 0l-4-4a1 1 0 1 1 1.414-1.414L11 13.586V4a1 1 0 0 1 1-1Zm-7 14a1 1 0 0 1 1 1v1h12v-1a1 1 0 1 1 2 0v2a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1Z"/>
        </svg>
    </button>
    <button @onclick="ToggleDecodeMicBar" title="Decode audio from the microphone" aria-label="Decode audio from the microphone" class="@ToolButton">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 15a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-2.08A7 7 0 0 0 19 12h-2Z"/>
        </svg>
    </button>
</div>

@* Light and Sound Components *@
<LightSection IsOpened="State.ActivePanel == Panel.Light"/>

<SoundSection IsOpened="State.ActivePanel == Panel.Sound"/>

<DecodeFromFileSection IsOpened="State.ActivePanel == Panel.DecodeFile"/>

<DecodeFromMicSection IsOpened="State.ActivePanel == Panel.DecodeMic"/>


@code {

    #region States

    [Inject] private AppState State { get; set; } = default!;

    #endregion

    const string ToolButton = "p-2 rounded-full border border-white transition-opacity hover:bg-white/10 "
                              + "disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent";

    string NothingToPlay => string.IsNullOrEmpty(State.Error)
        ? "Type something to convert first"
        : "Fix the input first — there's nothing valid to play";

    #region Methods

    protected override void OnInitialized() => State.Changed += HandleStateChanged;

    void HandleStateChanged() => StateHasChanged();

    void ToggleLightBar()
    {
        if (!ShouldSectionOpen())
            return;

        if (State.ActivePanel == Panel.Light)
            State.ClosePanel();
        else
            State.ShowPanel(Panel.Light);
    }

    void ToggleSoundBar()
    {
        if (!ShouldSectionOpen())
            return;

        if (State.ActivePanel == Panel.Sound)
            State.ClosePanel();
        else
            State.ShowPanel(Panel.Sound);
    }

    void ToggleDecodeFileBar()
    {
        if (State.ActivePanel == Panel.DecodeFile)
            State.ClosePanel();
        else
            State.ShowPanel(Panel.DecodeFile);
    }

    void ToggleDecodeMicBar()
    {
        if (State.ActivePanel == Panel.DecodeMic)
            State.ClosePanel();
        else
            State.ShowPanel(Panel.DecodeMic);
    }

    bool ShouldSectionOpen()
    {
        if (State.IsEncoding)
        {
            if (!string.IsNullOrEmpty(State.Input) && string.IsNullOrEmpty(State.Error))
                return true;
        }
        else
        {
            if (!string.IsNullOrEmpty(State.Output) && string.IsNullOrEmpty(State.Error))
                return true;
        }

        return false;
    }

    public void Dispose() => State.Changed -= HandleStateChanged;

    #endregion

}
