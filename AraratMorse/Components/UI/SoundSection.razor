@using AraratMorse.Components.UI.Player

@* Overlay *@
<div @onclick="@(async () => await CloseSectionAsync())" data-sheet-overlay="sound" class="@(IsOpened ? "fixed" : "hidden") inset-0 bg-black z-20 opacity-10"></div>

<div data-sheet="sound" inert="@(!IsOpened)" tabindex="-1" role="dialog" aria-modal="true" aria-label="Sound"
     class="fixed bottom-0 left-0 flex flex-col justify-between bg-black text-white h-full z-50 items-center w-full rounded-lg p-5 mt-10 transition-transform shadow-top @(!IsOpened ? "translate-y-full" : "translate-y-0")">

    @* Close Button *@
    <button @onclick="@(async () => await CloseSectionAsync())" class="text-white text-start self-start rounded-full p-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24">
            <path fill="currentColor" d="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10s10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17L12 13.41L8.41 17L7 15.59L10.59 12L7 8.41L8.41 7L12 10.59L15.59 7L17 8.41L13.41 12L17 15.59z"/>
        </svg>
    </button>

    <MorsePlayer @ref="_player" MorseText="@MorseText" Language="State.Language" Kind="PlayerKind.Sound"
                 Size="PlayerSize.Full" Active="IsOpened" DownloadName="@DownloadName"/>

</div>

@code {

    #region States

    [Inject] private AppState State { get; set; } = default!;

    #endregion

    #region Parameters

    [Parameter] public bool IsOpened { get; set; }

    #endregion

    #region Fields

    MorsePlayer? _player;

    #endregion

    #region Methods

    //The morse text is the encoded Output when encoding, or the typed morse Input when decoding.
    string MorseText => (State.IsEncoding ? State.Output : State.Input) ?? "";

    //First word of the source text, falling back to a fixed name when there isn't one.
    string DownloadName
    {
        get
        {
            var textName = State.IsEncoding ? State.Input : State.Output;
            var firstWord = textName?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault();
            return string.IsNullOrEmpty(firstWord) ? "morse" : firstWord;
        }
    }

    async Task CloseSectionAsync()
    {
        if (_player is not null)
            await _player.StopAsync();

        State.ClosePanel();
    }

    #endregion

}
